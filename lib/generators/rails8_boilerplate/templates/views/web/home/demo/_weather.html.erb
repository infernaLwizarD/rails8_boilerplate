<div class="border rounded p-3 bg-light">
  <div class="d-flex align-items-center justify-content-between">
    <div>
      <h5 class="mb-1"><i class="fas fa-map-marker-alt text-danger"></i> <%= weather[:city] %></h5>
      <p class="mb-0"><i class="fas fa-cloud-sun text-warning"></i> <%= weather[:condition] %></p>
    </div>
    <div class="text-end">
      <span class="display-6 fw-bold"><%= weather[:temp] %>&deg;C</span>
    </div>
  </div>
  <hr class="my-2">
  <small class="text-muted"><i class="fas fa-clock"></i> Загружено: <code><%= Time.zone.now.strftime('%H:%M:%S') %></code></small>
</div>
