<div id="message_<%= message[:id] %>" class="d-flex justify-content-between align-items-start border-bottom py-1">
  <div>
    <small class="text-muted"><%= message[:time] %></small>
    <span class="ms-2 small"><%= message[:text] %></span>
  </div>
  <%= button_to demo_stream_remove_path(target_id: "message_#{message[:id]}"), method: :post, class: "btn btn-sm btn-outline-danger border-0 p-0 ms-2", title: "Удалить" do %>
    <i class="fas fa-times"></i>
  <% end %>
</div>
