<div id="notification_<%= notification[:id] %>" class="alert alert-<%= notification[:type] %> py-2 px-3 mb-2 small d-flex justify-content-between align-items-center">
  <span>
    <i class="fas fa-info-circle me-1"></i>
    <strong><%= notification[:time] %></strong> — <%= notification[:text] %>
  </span>
  <%= button_to demo_stream_remove_path(target_id: "notification_#{notification[:id]}"), method: :post, class: "btn btn-sm btn-outline-secondary border-0 p-0 ms-2" do %>
    <i class="fas fa-times"></i>
  <% end %>
</div>
